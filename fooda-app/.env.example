# Copy this file to .env and fill in your values
# Never commit .env to version control

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

PAYSTACK_PUBLIC_KEY=pk_test_or_live_key_here

# Edge function secrets — set these in Supabase Dashboard → Project Settings → Edge Functions
# PAYSTACK_SECRET_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# SENDGRID_API_KEY=   # superseded by Resend

APP_ENV=development
DEFAULT_TAX_RATE=0.075
DEFAULT_DELIVERY_FEE=500
MIN_ORDER_AMOUNT=500

# ---------------------------------------------------------------------------
# Resend — transactional email
# ---------------------------------------------------------------------------
# RESEND_API_KEY is a SECRET. It belongs in Supabase Edge Function secrets, not
# here — the value below is only for local `supabase functions serve` runs.
#   supabase secrets set RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
#
# The sending domain must be verified in Resend (Domains -> Add Domain) before
# anything will deliver. Until then, only your own Resend account address works.
RESEND_API_KEY=re_your_resend_api_key_here

# Default envelope. Use a subdomain (mail.fooda.com) so a deliverability problem
# never damages your root domain's reputation.
RESEND_FROM_EMAIL=orders@fooda.com
RESEND_FROM_NAME=Fooda
RESEND_REPLY_TO=support@fooda.com

# Where operational alerts and daily digests are sent (comma-separated).
ADMIN_ALERT_EMAILS=admin@fooda.com

# Branding used by the email templates.
EMAIL_BRAND_NAME=Fooda
EMAIL_BRAND_TAGLINE=Bringing delicious food to your doorstep
EMAIL_BRAND_URL=https://fooda.com
EMAIL_SUPPORT_ADDRESS=support@fooda.com
EMAIL_SUPPORT_PHONE=
EMAIL_COMPANY_ADDRESS=Lagos, Nigeria
EMAIL_CURRENCY_SYMBOL=₦
# Hosted PNG/JPG logo, ~360x96. Leave blank to use the Fooda text wordmark.
# Gmail and Outlook strip SVG, so do not point this at an .svg file.
EMAIL_LOGO_URL=
